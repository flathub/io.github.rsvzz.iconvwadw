{
  "id": "io.github.rsvzz.iconvwadw",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "iconvwadw",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "HOME_CARGO": "/run/build/csven/cargo"
    }
  },
  "finish-args": [
    "--share=ipc",
    "--device=dri",
    "--socket=fallback-x11",
    "--socket=wayland"
  ],
  "modules": [
    {
      "name": "iconvwadw",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/rsvzz/iconvwadw-rs/releases/download/0.1.39/iconvwadw-rs_all.tar.xz",
          "sha256": "78f7d8946c68d761afa7d7c4fdd4b0d88716f88fa24c4900b0a3e9ad32a99d8f"
        }
      ]
    }
  ]
}
